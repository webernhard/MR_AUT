      </RoutineSettingsComponent>
      <CodeComponent name="rec_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="##  Audio recording parameters&amp;#10;sample_rate = 44100  # Sample rate (Hz)&amp;#10;channels = 2         # Number of audio channels (2 for stereo)&amp;#10;&amp;#10;##  Create a directory for recordings if it doesn't exist&amp;#10;recordings_dir = &quot;audio_recordings&quot;&amp;#10;if not os.path.exists(recordings_dir):&amp;#10;    os.makedirs(recordings_dir)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="##  Total runtime limit (3 minutes)&amp;#10;total_runtime = 1 * 60  # 'n' minutes in seconds&amp;#10;#program_start_time = datetime.now()&amp;#10;practice_start_time = core.getTime()&amp;#10;#practice_end_time = program_start_time + timedelta(seconds=total_runtime)&amp;#10;practice_end_time = practice_start_time + total_runtime&amp;#10;&amp;#10;##  Counter for recording enumeration&amp;#10;recording_count = 1&amp;#10;&amp;#10;print(&quot;Audio Recorder - Press and hold SPACEBAR to record, release to stop&quot;)&amp;#10;print(f&quot;Program will automatically exit after {total_runtime//60} minutes&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="##  bws code snippet  ##&amp;#10;##if core.getTime() &gt; p_startTime + p_loopDur:&amp;#10;##    #print(p_startTime + p_loopDur)&amp;#10;##    p_finish = True&amp;#10;##    #print(&quot;p_finish = 1&quot;)&amp;#10;##    continueRoutine = False # finish p_trial&amp;#10;&amp;#10;#while datetime.now() &lt; program_end_time:&amp;#10;while core.getTime() &lt; practice_end_time:&amp;#10;#    # Calculate and display remaining time&amp;#10;#    time_remaining = (practice_end_time - datetime.now()).total_seconds()&amp;#10;#    if int(time_remaining) % 30 == 0:  # Show time remaining every 30 seconds&amp;#10;#        print(f&quot;Time remaining: {int(time_remaining)} seconds&quot;)&amp;#10;    &amp;#10;    ## check for keypresses&amp;#10;    p_response = event.getKeys()&amp;#10;    &amp;#10;    if p_response:&amp;#10;        &amp;#10;        # Check for quit command&amp;#10;        if 'escape' or 'q' in p_response:&amp;#10;            continueRoutine = False&amp;#10;        &amp;#10;        # get last key in p_response&amp;#10;        p_resp_key = p_response.pop()&amp;#10;        &amp;#10;        &quot;&quot;&quot;        &amp;#10;        for thisKey in p_response:&amp;#10;            if thisKey==' ':  # it is equivalent to the string 'q'&amp;#10;                print('space-key-press:', thisKey.name, thisKey.tDown, thisKey.rt)&amp;#10;            else:&amp;#10;                print(thisKey.name, thisKey.tDown, thisKey.rt)&amp;#10;        &quot;&quot;&quot;&amp;#10;&amp;#10;&amp;#10;        ##  Check for recording command (spacebar)  ##&amp;#10;        #if keyboard.is_pressed('space'):&amp;#10;        if p_resp_key == 'space':&amp;#10;            ## Generate filename with enumeration and timestamp&amp;#10;            #timestamp = datetime.now().strftime(&quot;%Y%m%d_%H%M%S&quot;)&amp;#10;            timestamp = data.getDateStr(format=&quot;%H:%M:%S.%m&quot;)&amp;#10;            &amp;#10;            filename = os.path.join(recordings_dir, f&quot;{recording_count:02d}_recording_{timestamp}.wav&quot;)&amp;#10;            &amp;#10;            # Start recording&amp;#10;            print(f&quot;Recording #{recording_count} started... (Release SPACEBAR to stop)&quot;)&amp;#10;            audio_data = []&amp;#10;            &amp;#10;            # Record audio stream&amp;#10;            with sd.InputStream(samplerate=sample_rate, channels=channels, callback=lambda indata, frames, time, status: audio_data.append(indata.copy())):&amp;#10;                # Continue recording until spacebar is released or program time limit is reached&amp;#10;                while keyboard.is_pressed('space') and datetime.now() &lt; program_end_time:&amp;#10;                    time.sleep(0.01)  # Small delay to prevent CPU overuse&amp;#10;            &amp;#10;            # Check if we've reached the program time limit&amp;#10;            if datetime.now() &gt;= program_end_time:&amp;#10;                print(&quot;Program time limit reached during recording&quot;)&amp;#10;            &amp;#10;            if audio_data:&amp;#10;                # Convert list of numpy arrays into one large numpy array&amp;#10;                recording = np.concatenate(audio_data, axis=0)&amp;#10;                &amp;#10;                # Save the recording to a file&amp;#10;                sf.write(filename, recording, sample_rate)&amp;#10;                print(f&quot;Recording #{recording_count} saved to {filename}&quot;)&amp;#10;                recording_count += 1  # Increment the recording counter&amp;#10;            else:&amp;#10;                print(&quot;Recording too short - nothing saved&quot;)&amp;#10;                &amp;#10;    time.sleep(0.01)  # Small delay in main loop to prevent CPU overuse" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="print(f&quot;\nProgram ended after {total_runtime//60} minutes&quot;)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="True" valType="bool" updates="None" name="disabled"/>
        <Param val="rec_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="p_idea">
      <RoutineSettingsComponent name="p_idea" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
