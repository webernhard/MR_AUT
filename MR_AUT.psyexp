      <BidsEventComponent name="bidsE_fix" plugin="psychopy-bids">
        <Param val="" valType="str" updates="None" name="HED"/>
        <Param val="False" valType="bool" updates="None" name="add_log"/>
        <Param val="" valType="num" updates="None" name="bids_duration"/>
