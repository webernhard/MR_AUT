  <Flow>
    <Routine name="settings"/>
    <LoopInitiator loopType="TrialHandler" name="wait4scanner_byp">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="wait4scanner_byp" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="wait4scanner"/>
    <LoopTerminator name="wait4scanner_byp"/>
    <LoopInitiator loopType="TrialHandler" name="MR_AUT_blocks">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('MR_AUT_condition_file', 'stim/MR_AUT_items_n1.csv')]), OrderedDict([('MR_AUT_condition_file', 'stim/MR_AUT_items_n2.csv')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="stim/MR_AUT_blocks.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="MR_AUT_blocks" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
