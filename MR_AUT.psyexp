        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="keys = event.getKeys()&amp;#10;&amp;#10;if len(keys):&amp;#10;    if goLeft_key in keys:&amp;#10;        likertRating.markerPos = likertRating.markerPos - 1&amp;#10;    elif goRight_key in keys:&amp;#10;        likertRating.markerPos = likertRating.markerPos  + 1 " valType="extendedCode" updates="constant" name="Each Frame"/>
